# Example configuration for the Lychee Upload middleware
# Archives photos posted in chat rooms to an album on a self-hosted Lychee
# instance (v6 or newer, API v2). Silent on success; when a photo could not be
# archived a short message is posted back into the room it came from.
#
# Prerequisites:
#   - A Lychee API token: log in, open Settings -> Profile -> API Token, and
#     click "Create token". It is only shown once; treat it like a password.
#   - The destination album's ID: the 24-character string at the end of the
#     album URL, e.g. https://photos.example.com/gallery/AbCdEfGhIjKlMnOpQrStUvWx
#
# What gets uploaded is the original file exactly as it was sent to Matrix
# (full resolution, EXIF intact). The bot never resizes or re-encodes, so ask
# people to send originals from their client rather than compressed copies.

KELVIN__MIDDLEWARES__lychee__KIND=lycheeupload
KELVIN__MIDDLEWARES__lychee__SERVICE_ID=matrix_main

# Comma-separated room IDs to archive from. Omit (or leave empty) to archive
# every room on the service except direct chats.
KELVIN__MIDDLEWARES__lychee__ROOM_IDS=!photos:matrix.org,!trips:matrix.org

# Optional: rooms that are never archived, even if listed above. Useful for
# direct chats the bot joined before it learned to classify them.
# KELVIN__MIDDLEWARES__lychee__EXCLUDE_ROOM_IDS=!private:matrix.org

# Lychee origin (no trailing path) and API token.
KELVIN__MIDDLEWARES__lychee__LYCHEE_URL=https://photos.example.com
KELVIN__MIDDLEWARES__lychee__LYCHEE_TOKEN=your_lychee_api_token

# Destination album ID.
KELVIN__MIDDLEWARES__lychee__ALBUM_ID=AbCdEfGhIjKlMnOpQrStUvWx

# Optional: largest file (bytes) sent in the single-chunk upload. Default is
# 52428800 (50 MiB). Keep it at or below the PHP upload_max_filesize and
# post_max_size configured for your Lychee instance. Bigger photos are skipped
# and OVERSIZE_MESSAGE is posted instead.
# KELVIN__MIDDLEWARES__lychee__MAX_FILE_SIZE_BYTES=52428800

# Optional: messages posted back into the room. {max_mb} renders the limit.
# KELVIN__MIDDLEWARES__lychee__FAILURE_MESSAGE=Sorry, I couldn't archive that photo to the album. Please try sending it again later.
# KELVIN__MIDDLEWARES__lychee__OVERSIZE_MESSAGE=Sorry, that photo is too large to archive (limit {max_mb} MB).

# Optional: whole-request timeout for one upload (default 60s). Raise it for
# large photos on slow links.
# KELVIN__MIDDLEWARES__lychee__REQUEST_TIMEOUT=60s

# The middleware must be attached to the Matrix service's pipeline:
# KELVIN__SERVICES__matrix_main__MIDDLEWARE=logger,lychee

# Notes:
# - Only images (m.image) are archived. Videos and generic file attachments are
#   ignored, as are images sent in direct chats with the bot.
# - Archived photos are remembered in <data_directory>/lychee.store.json so a
#   restart never uploads the same photo twice.
# - Only photos posted while the bot is running are archived: the initial sync
#   backlog (including anything sent while the bot was down) is never uploaded.
# - The photo's description in Lychee records who sent it and in which room.
#
# Sanity-check the token and album before starting the bot:
#
#   curl -sS -H "Accept: application/json" -H "Content-Type: application/json" \
#     -H "Authorization: Bearer $LYCHEE_TOKEN" \
#     https://photos.example.com/api/v2/Albums | jq '.albums[] | {id, title}'
#
#   curl -sS -X POST https://photos.example.com/api/v2/Photo \
#     -H "Accept: application/json" -H "Authorization: Bearer $LYCHEE_TOKEN" \
#     -F album_id=$ALBUM_ID -F file=@test.jpg -F file_name=test.jpg \
#     -F uuid_name= -F extension= -F chunk_number=1 -F total_chunks=1 \
#     -F "description=curl sanity check"
