# Kanidm identity middleware configuration
#
# Provides two DM commands to local homeserver users:
#   !reset                        - generate a credential reset link for the
#                                   caller's own kanidm account
#   !invite <username> <email>    - create a new kanidm person account (email
#                                   is required, for account recovery) and
#                                   return a credential setup link to forward
#
# Copy the settings below into your active .env and fill in the values.
#
# Prerequisites:
#   - The kanidm service account whose API token is used below must belong to a
#     group with people write/onboarding rights (idm_people_on_boarding,
#     idm_people_admins, or idm_service_desk). Generate the token with:
#       kanidm service-account api-token generate <account> kelvinbot
#   - The MAS client must be allowed the `urn:mas:admin` scope and be able to use
#     the client_credentials grant. MAS is used to resolve a Matrix user to their
#     linked kanidm account for !reset.

KELVIN__MIDDLEWARES__identity__KIND=kanidm

# kanidm server origin and service-account API token
KELVIN__MIDDLEWARES__identity__KANIDM_URL=https://idm.example.com
KELVIN__MIDDLEWARES__identity__KANIDM_TOKEN=your_kanidm_service_account_api_token

# Matrix Authentication Service admin client (client_credentials, urn:mas:admin)
KELVIN__MIDDLEWARES__identity__MAS_URL=https://auth.example.com
KELVIN__MIDDLEWARES__identity__MAS_CLIENT_ID=your_mas_admin_client_id
KELVIN__MIDDLEWARES__identity__MAS_CLIENT_SECRET=your_mas_admin_client_secret

# The MAS upstream OAuth provider id corresponding to kanidm
KELVIN__MIDDLEWARES__identity__MAS_PROVIDER_ID=your_kanidm_upstream_provider_id

# Optional overrides
# KELVIN__MIDDLEWARES__identity__COMMAND_RESET=!reset
# KELVIN__MIDDLEWARES__identity__COMMAND_INVITE=!invite
# Reset-link validity windows (human-readable; kanidm clamps to 5m..24h)
# Defaults: reset=10m (caller acts immediately), invite=24h (forwarded to a new person)
# KELVIN__MIDDLEWARES__identity__RESET_TOKEN_TTL=10m
# KELVIN__MIDDLEWARES__identity__INVITE_TOKEN_TTL=24h

# Remember to attach the middleware to your Matrix service, e.g.:
# KELVIN__SERVICES__matrix_main__MIDDLEWARE=identity,logger
