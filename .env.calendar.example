# Example configuration for the Calendar Agenda middleware
# Posts a daily agenda from a shared webcal/ics feed to a chat room, including
# countdowns to upcoming multi-day events and reminders for upcoming one-off
# events. Nothing is posted on days where none of those sections have content.

KELVIN__MIDDLEWARES__calendar__KIND=calendaragenda
KELVIN__MIDDLEWARES__calendar__SERVICE_ID=matrix_main
KELVIN__MIDDLEWARES__calendar__ROOM_ID=!room:matrix.org

# The ICS feed the bot reads. webcal:// and webcals:// are rewritten to https://.
# Treat this as a secret: it is never rendered into a message or logged.
KELVIN__MIDDLEWARES__calendar__CALENDAR_URL=webcal://calendar.example.com/private/feed.ics

# Optional human-facing calendar link, rendered as a footer on the agenda.
# Separate from CALENDAR_URL so the private feed is never shared in chat.
# Omit to render no footer.
KELVIN__MIDDLEWARES__calendar__CALENDAR_LINK=https://calendar.example.com/shared/abc
# KELVIN__MIDDLEWARES__calendar__CALENDAR_LINK_TEXT=View the full calendar

# Local time of day to post the daily agenda, 24h HH:MM.
KELVIN__MIDDLEWARES__calendar__POST_AT_TIME=08:00

# Days-before intervals at which multi-day events get a countdown line.
# Defaults to 90,60,30,14,7.
KELVIN__MIDDLEWARES__calendar__COUNTDOWN_DAYS=90,60,30,14,7

# Days-before intervals at which single-day, non-recurring events get a
# reminder line. Recurring events are excluded so weekly meetings don't nag.
# Defaults to 7,1.
KELVIN__MIDDLEWARES__calendar__REMINDER_DAYS=7,1

# Minimum length in days for an event to count as "multi-day" (countdowns).
# Anything shorter is treated as a single-day event (reminders). Defaults to 2.
# KELVIN__MIDDLEWARES__calendar__MULTI_DAY_MIN_DAYS=2

# Section headings.
# KELVIN__MIDDLEWARES__calendar__HEADING_TODAY=Today
# KELVIN__MIDDLEWARES__calendar__HEADING_REMINDERS=Coming up
# KELVIN__MIDDLEWARES__calendar__HEADING_COUNTDOWNS=Countdowns

# Optional chat command that posts the agenda on demand. Omit to disable.
KELVIN__MIDDLEWARES__calendar__COMMAND_STRING=!agenda

# The middleware must be attached to the service's pipeline: its scheduled task
# only starts when it appears in some MIDDLEWARE list, and the on-demand command
# needs the event flow.
# KELVIN__SERVICES__matrix_main__MIDDLEWARE=logger,calendar

# Example output:
#
# ### 📅 Tuesday, August 4
#
# **Today**
# - 8 PM – 10 PM — Game night _(Living room)_
# - All day — Camping trip (through Sat, Aug 8)
#
# **Coming up**
# - Alice's birthday party — in 7 days (Tue, Aug 11)
#
# **Countdowns**
# - Beach week — in 30 days (Sep 3 – Sep 7)
#
# [View the full calendar](https://calendar.example.com/shared/abc)
#
# Notes:
# - Multi-day events are listed under Today only on their first day.
# - Recurring events (RRULE) are expanded, so their occurrences show under
#   Today, but they never generate reminders.
# - All dates and times use the bot's local timezone.
